# 复制为 .env 后按需修改；docker compose 会自动读取同目录下的 .env

# ---- Web 管理界面 ----
WEB_PORT=8080
# 同时设置两者即开启 Basic Auth；留空则局域网内免认证访问
WEB_USER=admin
WEB_PASS=

# ---- DHCP ----
# 监听接口：留空表示除 lo 外全部接口；host 网络下一般为 eth0 / ens18 / enp0s3
DHCP_INTERFACE=eth0
DHCP_RANGE_START=192.168.1.100
DHCP_RANGE_END=192.168.1.200
DHCP_NETMASK=255.255.255.0
DHCP_LEASE_TIME=24h
DHCP_GATEWAY=192.168.1.1
# 下发给客户端的 DNS，逗号分隔
DHCP_DNS=192.168.1.1, 223.5.5.5
DHCP_DOMAIN=lan

# ---- DNS 转发 ----
DNS_FORWARDERS=223.5.5.5, 114.114.114.114
DNS_ENABLED=1

# ---- 其它 ----
# 客户端最后活跃时间在多少秒内视为在线
ONLINE_WINDOW=900
